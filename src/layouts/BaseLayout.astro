---
import '../styles/global.css';

interface Props {
  title: string;
  bodyClass?: string;
  footerThird?: { label: string; href: string };
}

const {
  title,
  bodyClass,
  footerThird = { label: 'GitHub', href: 'https://github.com/' },
} = Astro.props;

const path = Astro.url.pathname;
const isHome = path === '/';
const isAbout = path === '/about' || path === '/about/';
const isApps = path === '/apps' || path === '/apps/' || path.startsWith('/apps/');
const isContact = path === '/contact' || path === '/contact/';
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
</head>
<body class={bodyClass}>

<header class="site-head">
  <div class="shell">
    {isHome
      ? <span class="who">Christoph Pageler</span>
      : <a class="who" href="/">Christoph Pageler</a>}
    <nav>
      <a href="/about" aria-current={isAbout ? 'page' : undefined}>About</a>
      <a href="/apps" aria-current={isApps ? 'page' : undefined}>Apps</a>
      <a href="/contact" aria-current={isContact ? 'page' : undefined}>Contact</a>
    </nav>
  </div>
</header>

<main>
  <div class="shell">
    <slot />
  </div>
</main>

<footer class="site-foot">
  <div class="shell">
    <a href="/legal-notice">Legal Notice</a>
    <a href="/privacy">Privacy</a>
    <a href={footerThird.href}>{footerThird.label}</a>
  </div>
</footer>

</body>
</html>
