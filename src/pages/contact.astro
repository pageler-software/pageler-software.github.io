---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — Christoph Pageler" footerThird={{ label: 'Apps', href: '/apps' }}>
  <h1 class="page-title">Contact</h1>
  <p class="lede">Email is the fastest way to reach me — for support questions about an app, or anything else.</p>

  <div class="block">
    <h2>reach me</h2>
    <div class="rows plain">
      <div><span>Email</span><a class="val" href="mailto:christoph@pageler-software.de">christoph@pageler-software.de</a></div>
      <div><span>GitHub</span><a class="val" href="https://github.com/">github.com</a></div>
      <div><span>Location</span><span class="val">Oldenburg, Germany</span></div>
    </div>
  </div>

  <div class="block">
    <h2>app support</h2>
    <p>If you are writing about one of my apps, mention which one and which iOS version you are on. It saves us both a round trip.</p>
  </div>
</BaseLayout>
